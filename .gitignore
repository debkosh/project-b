# Upstream and toolchains, fetched by tools/fetch-chromium.sh, never committed.
/chromium/
/depot_tools/
# Build outputs.
/build/
/shell/node_modules/
/shell/dist/
# The shell's pages as the build copies them into Go (core/shellfiles).
/core/shellfiles/dist/*
!/core/shellfiles/dist/.keep
.DS_Store
__pycache__/
# Tools fetched or built for this machine: ChromeDriver.
/.tools/
# Signing keys of someone without keykosh (tools/keys.sh).
/.keys/
# Editor settings, per person.
/.idea/
/.claude/
/core/dev
