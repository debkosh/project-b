// What the browser process tells a renderer of ours: the ad blocker's rules for all its
// pages, and a frame's sparks for the page about to commit in it (docs/site-features.md);
// and the form script with its messages, both ways (docs/password-autofill.md).
module project_b.mojom;

import "mojo/public/mojom/base/unguessable_token.mojom";

// One of the person's scripts, which runs in a world of its own.
struct Spark {
  // Go's id for it; each id gets its own world.
  string id;
  string source;
  // At document start, as the page's first element is made; else once its document has
  // loaded (DOMContentLoaded).
  bool at_start;
};

// Every renderer's, on its channel.
interface Renderer {
  // The hosts the ad blocker keeps requests from, and any under them, lower case; and the
  // origins of the pages it lets reach them.
  SetAdRules(array<string> hosts, array<string> off);
  // The form script, which each frame of a web page runs at document start in a world of
  // its own.
  SetFormScript(string source);
};

// The browser's, on each renderer's channel: what the renderer tells it.
interface AdReports {
  // The ad blocker refused a request of the frame's, named by its frame token.
  Blocked(mojo_base.mojom.UnguessableToken frame);
};

// Each frame's, on its channel, told before a page commits in the frame.
interface Frame {
  // The scripts the page at url runs; none clears them.
  SetSparks(string url, array<Spark> sparks);
  // A message of the page protocol for the frame's form script: kind and its JSON.
  FormMessage(string kind, string json);
};

// The browser's, on each frame's channel: what the frame asks of it.
interface FrameHost {
  // The page called window.print(). The browser asks Go, and prints the frame through the
  // system's panel if Go says so (docs/daily-driver.md, Printing).
  Print();
  // A message of the page protocol from the frame's form script: kind and its JSON. Only
  // the script's world can send one.
  FormMessage(string kind, string json);
};
