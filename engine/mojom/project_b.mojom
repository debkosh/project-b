// What the browser process tells a renderer of ours: whether there is a blocker, its
// watcher and the sites where it is off, for all its pages, and a frame's sparks and
// blocked parts for the page about to commit in it (docs/site-features.md,
// docs/blocking.md); the form script with its messages, both ways
// (docs/password-autofill.md); and what a renderer asks of the blocker.
module project_b.mojom;

import "mojo/public/mojom/base/unguessable_token.mojom";

// One of the person's scripts, which runs in a world of its own.
struct Spark {
  // Go's id for it; each id gets its own world.
  string id;
  string source;
  // At document start, as the page's first element is made; else once its document has
  // loaded (DOMContentLoaded).
  bool at_start;
};

// Every renderer's, on its channel.
interface Renderer {
  // Whether there is a blocker, and the watcher's script, which each frame where the
  // blocker is on runs at document start in a world of its own. The renderer forgets the
  // answers it kept.
  SetBlocker(bool on, string watcher_script);
  // The blocker's rules changed: the renderer forgets the answers it kept.
  BlockerChanged();
  // The origins of the pages where the blocker is off: their requests aren't asked about.
  SetBlockingOff(array<string> origins);
  // The form script, which each frame of a web page runs at document start in a world of
  // its own.
  SetFormScript(string source);
};

// The browser's, on each renderer's channel: what the renderer tells it.
interface AdReports {
  // The ad blocker refused a request of the frame's, named by its frame token.
  Blocked(mojo_base.mojom.UnguessableToken frame);
};

// A request's verdicts, PB_BLOCKER_ALLOW, _BLOCK and _REDIRECT in pb_abi.h.
const int32 kBlockerAllow = 0;
const int32 kBlockerBlock = 1;
const int32 kBlockerRedirect = 2;

// The browser's, one pipe per renderer, answered on a sequence of its own in the browser
// (engine/browser/blocker.cc), never the main thread: what a renderer asks of the blocker.
interface Blocker {
  // A request of a page: its address, the address of the page's site, and its kind in
  // adblock's words.
  Check(string url, string source, string type) => (int32 verdict);
  // The watcher's question for the page at page_url, JSON {"classes": [...], "ids": [...]};
  // the answer a JSON array of selectors to hide.
  Hide(string page_url, string query) => (string selectors);
};

// Each frame's, on its channel, told before a page commits in the frame: what the blocker
// hides and runs in the page at url, as the blocker's page hook gives it (pb_abi.h), "" for
// nothing but the watcher. Not told at all, the frame runs none of it.
interface BlockerFrame {
  SetPage(string url, string parts);
};

// Each frame's, on its channel, told before a page commits in the frame.
interface Frame {
  // The scripts the page at url runs; none clears them.
  SetSparks(string url, array<Spark> sparks);
  // A message of the page protocol for the frame's form script: kind and its JSON.
  FormMessage(string kind, string json);
};

// The browser's, on each frame's channel: what the frame asks of it.
interface FrameHost {
  // The page called window.print(). The browser asks Go, and prints the frame through the
  // system's panel if Go says so (docs/daily-driver.md, Printing).
  Print();
  // A message of the page protocol from the frame's form script: kind and its JSON. Only
  // the script's world can send one.
  FormMessage(string kind, string json);
};
