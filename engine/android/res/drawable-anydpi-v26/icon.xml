<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon from Android 8: two layers the launcher masks to its own shape, so it fills
     the circle like other apps' rather than sitting small inside a white one. Older Android uses
     res/drawable/icon.xml. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/icon_background" />
    <foreground android:drawable="@drawable/icon_foreground" />
</adaptive-icon>
