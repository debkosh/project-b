<?xml version="1.0" encoding="utf-8"?>
<!-- The folders other apps may read, through the one FileProvider: where Go's updater stages a
     downloaded APK for the package installer (core/cmd/lib/update_android.go), and where Go
     writes the crash reports the user shares (core/crash/report.go), and where the long-press
     menu puts the images it shares and copies (core/app/contextmenu.go). The profile is in
     Chromium's data folder, app_project_b beside files/, which FileProvider has no tag for. -->
<paths>
    <files-path name="updates" path="../app_project_b/profile/updates/stage/" />
    <files-path name="reports" path="../app_project_b/profile/reports/" />
    <files-path name="shared" path="../app_project_b/profile/shared/" />
</paths>
